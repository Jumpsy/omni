{
  "version": 1,
  "hooks": [
    {
      "name": "format-on-write",
      "type": "post-write",
      "command": "bin/format-on-write.sh"
    },
    {
      "name": "protected-file-guard",
      "type": "pre-write",
      "command": "bin/protected-file-guard.sh"
    },
    {
      "name": "static-quality-gate",
      "type": "post-write",
      "command": "bin/static-quality-gate.sh"
    },
    {
      "name": "placeholder-content-detector",
      "type": "post-write",
      "command": "bin/placeholder-content-detector.sh"
    },
    {
